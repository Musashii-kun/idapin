<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32"><Configuration>Debug</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32"><Configuration>Release</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{639EF517-FCFC-408E-9500-71F0DC0458DB}</ProjectGuid>
    <RootNamespace>idadbg</RootNamespace>
    <Keyword>MakeFileProj</Keyword>
    <ProjectName>idadbg</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <!-- Pin 4 cannot use cl.exe or the host CRT. Delegate to the kit's GNU
       make rules so both IDE and command-line builds use Pin RT wrappers. -->
  <PropertyGroup>
    <PinRoot Condition="'$(PinRoot)'==''">$(PIN_ROOT)</PinRoot>
    <PinBash Condition="'$(PinBash)'==''">bash.exe</PinBash>
    <PinTarget Condition="'$(Platform)'=='Win32'">ia32</PinTarget>
    <PinTarget Condition="'$(Platform)'=='x64'">intel64</PinTarget>
    <PinDebug Condition="'$(Configuration)'=='Debug'">1</PinDebug>
    <PinDebug Condition="'$(Configuration)'!='Debug'">0</PinDebug>
    <TargetName Condition="'$(Platform)'=='Win32'">idadbg</TargetName>
    <TargetName Condition="'$(Platform)'=='x64'">idadbg64</TargetName>
    <OutDir>$(ProjectDir)obj-$(PinTarget)-$(Configuration)\</OutDir>
    <IntDir>$(OutDir)</IntDir>
    <PinSourceUnix>$([System.String]::Copy('$(ProjectDir)').Replace('\', '/'))</PinSourceUnix>
    <PinRootUnix>$([System.String]::Copy('$(PinRoot)').Replace('\', '/'))</PinRootUnix>
    <PinMakeArgs>-C '$(PinSourceUnix)' PIN_ROOT='$(PinRootUnix)' TARGET=$(PinTarget) DEBUG=$(PinDebug) OBJDIR=obj-$(PinTarget)-$(Configuration)/</PinMakeArgs>
    <NMakeBuildCommandLine>"$(PinBash)" -c "make $(PinMakeArgs) tools"</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>"$(PinBash)" -c "make $(PinMakeArgs) clean &amp;&amp; make $(PinMakeArgs) tools"</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>"$(PinBash)" -c "make $(PinMakeArgs) clean"</NMakeCleanCommandLine>
    <NMakeOutput>$(OutDir)$(TargetName).dll</NMakeOutput>
    <NMakeIncludeSearchPath>$(PinRoot)\source\include\pin;$(PinRoot)\source\include\pin\gen;$(PinRoot)\$(PinTarget)\pinrt\include;$(PinRoot)\$(PinTarget)\pinrt\include\c++;$(PinRoot)\$(PinTarget)\pinrt\include\adaptor;$(PinRoot)\extras\xed-$(PinTarget)\include\xed</NMakeIncludeSearchPath>
  </PropertyGroup>
  <Target Name="CheckPinRoot" BeforeTargets="Build;Rebuild;Clean">
    <Error Condition="'$(PinRoot)'==''" Text="Set PIN_ROOT or /p:PinRoot to the Windows PIN 4.4 kit root. See readme.txt for LLVM and shell setup." />
    <Error Condition="'$(PinRoot)'!='' and !Exists('$(PinRoot)\source\tools\Config\makefile.win.config')" Text="PinRoot must identify a PIN kit with Windows build rules." />
  </Target>
  <ItemGroup><ClCompile Include="idadbg.cpp" /></ItemGroup>
  <ItemGroup><ClInclude Include="idadbg.h" /><ClInclude Include="idadbg_local.h" /><ClInclude Include="idadbg_event_ids.h" /></ItemGroup>
  <ItemGroup><None Include="readme.txt" /><None Include="makefile" /><None Include="makefile.rules" /></ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
