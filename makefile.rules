##############################################################
#
# This file includes all the test targets as well as all the
# non-default build rules and test recipes.
#
##############################################################

# IDA-specific configuration to generate proper DLL name.
ifeq ($(TARGET),intel64)
  BITNESS := 64
endif


# Retain vs_build's optimized builds with symbols, using Pin RT wrappers.
# The kit has already expanded TOOL_CXXFLAGS; changing *_NOOPT here is too late.
ifeq ($(TARGET_OS),linux)
  TOOL_CXXFLAGS += -g
endif
ifeq ($(TARGET_OS),windows)
  TOOL_CXXFLAGS += -Z7
  TOOL_LDFLAGS += /DEBUG:FULL /PDBALTPATH:%_PDB%
endif


##############################################################
#
# Test targets
#
##############################################################

###### Place all generic definitions here ######

# idadbg needs an IDA protocol client; the kit's generic test recipe would
# wait forever for a connection. Run tests/smoke.py explicitly instead.
TOOL_ROOTS := idadbg$(BITNESS)

##############################################################
#
# Build rules
#
##############################################################
# -]
ifdef IDA_OBJDIR
  OBJDIR := $(IDA_OBJDIR)/
  $(OBJDIR):
	@mkdir -p 2>/dev/null $(OBJDIR)

  # Pin 4 must retain the kit's TOOL_* runtime wrappers. Legacy kits used
  # CC/CXX/LINKER directly; honor IDA's compiler overrides only there.
  ifndef TOOL_CXX
    CC := "$(IDA_CC)"
    CXX := "$(IDA_CXX)"
    LINKER := "$(IDA_CCL)"
  endif
  TOOL_CXXFLAGS += $(IDA_EXTRA_CXXFLAGS)
  TOOL_LDFLAGS += $(IDA_EXTRA_LDFLAGS)
endif
# -[

# Pin 4 renamed the tool linker; older kits used LINKER.
IDAPIN_LINKER = $(if $(TOOL_LINKER),$(TOOL_LINKER),$(LINKER))

# Recompile when either header changes (not just relink).
$(OBJDIR)idadbg$(OBJ_SUFFIX): idadbg.h idadbg_local.h idadbg_event_ids.h

# special rule for IDA's 64-bit DLLs (with non-suffixed object file name).
# (copied form makefile.default.rules).
$(OBJDIR)idadbg$(BITNESS)$(PINTOOL_SUFFIX): $(OBJDIR)idadbg$(OBJ_SUFFIX) idadbg.h idadbg_local.h idadbg_event_ids.h
	$(IDAPIN_LINKER) $(TOOL_LDFLAGS) $(LINK_EXE)$@ $< $(TOOL_LPATHS) $(TOOL_LIBS)
